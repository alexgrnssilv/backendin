PORT=3001
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# Token de acesso do Mercado Pago (Sandbox ou Produção)
MP_ACCESS_TOKEN="APP_USR-..."

# Chave Secreta do Webhook do Mercado Pago (Disponível em Painel de Integrações > Webhooks)
# Essencial em produção para validar a assinatura das requisições e evitar fraudes.
# Se deixado em branco, a validação de assinatura é pulada (permitido apenas para testes locais).
MP_WEBHOOK_SECRET="seu-webhook-secret"

# URL Base da aplicação - Utilizada para montar o webhook e redirecionamento de checkout
# Em produção: "https://seu-app.onrender.com"
# Em desenvolvimento: "https://sua-url-localtunnel.loca.lt"
BASE_URL="http://localhost:3001"

# Configurações do Cloudinary para upload de imagens
CLOUDINARY_CLOUD_NAME="seu_cloud_name"
CLOUDINARY_API_KEY="sua_api_key"
CLOUDINARY_API_SECRET="seu_api_secret"
